{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "City source catalogue",
 "type": "object",
 "required": [
  "city",
  "country",
  "timezone",
  "licences",
  "sources"
 ],
 "properties": {
  "city": {
   "type": "string",
   "pattern": "^[a-z0-9-]+$"
  },
  "country": {
   "type": "string",
   "minLength": 2,
   "maxLength": 2
  },
  "timezone": {
   "type": "string"
  },
  "licences": {
   "type": "object",
   "additionalProperties": {
    "type": "object",
    "required": [
     "name",
     "url"
    ],
    "properties": {
     "name": {
      "type": "string"
     },
     "url": {
      "type": "string",
      "format": "uri"
     }
    }
   }
  },
  "sources": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "object",
    "required": [
     "id",
     "title",
     "publisher",
     "dataset",
     "licence",
     "cadence",
     "size",
     "layer",
     "fetch"
    ],
    "properties": {
     "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
     },
     "title": {
      "type": "string"
     },
     "publisher": {
      "type": "string"
     },
     "dataset": {
      "type": "string"
     },
     "licence": {
      "type": "string"
     },
     "cadence": {
      "type": "string"
     },
     "size": {
      "enum": [
       "small",
       "large"
      ]
     },
     "layer": {
      "enum": [
       "movement",
       "safety",
       "weather",
       "operations",
       "community",
       "context"
      ]
     },
     "fetch": {
      "type": "object",
      "required": [
       "kind"
      ],
      "properties": {
       "kind": {
        "enum": [
         "url",
         "ckan-dump",
         "ckan-package",
         "arcgis",
         "ogc"
        ]
       },
       "ext": {
        "type": "string"
       }
      }
     },
     "fields_of_interest": {
      "type": "array",
      "items": {
       "type": "string"
      }
     },
     "limits": {
      "type": "string"
     }
    }
   }
  },
  "not_open": {
   "type": "array",
   "items": {
    "type": "string"
   }
  }
 }
}